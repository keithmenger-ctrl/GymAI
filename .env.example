# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: invites, webhook
# Postgres connection string (Supabase: Settings > Database > pooled/transaction connection)
DATABASE_URL=
# Local dev only: run GoTrue yourself and proxy /auth/v1 to it (see README)
DEV_GOTRUE_URL=
# Public URL of the app (required for emailed links in production)
APP_URL=
# Transactional email (invites, forgot password). Any SMTP provider. Leave empty to use copy-paste links.
SMTP_URL=                         # e.g. smtps://resend:API_KEY@smtp.resend.com:465  (local: smtp://127.0.0.1:2525)
MAIL_FROM=                        # e.g. "AcademyOS <noreply@yourdomain.com>"
STRIPE_SECRET_KEY=                # optional: dev mode is used when empty
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=                # optional: AI drafts fall back to templates
